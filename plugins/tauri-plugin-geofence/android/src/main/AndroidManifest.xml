<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Position précise : indispensable au géofencing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10+ : détecter l'arrivée quand l'appli est fermée. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 13+ : afficher la notification d'arrivée. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Les géofences sont effacées au redémarrage : on les réenregistre. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name="fr.eveetlucas.geofence.GeofenceReceiver"
            android:exported="false" />
        <receiver
            android:name="fr.eveetlucas.geofence.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
