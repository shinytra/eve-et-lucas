{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eve & Lucas",
  "version": "0.5.0",
  "identifier": "fr.eveetlucas.couple",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eve & Lucas",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://s4.anilist.co https://i.ytimg.com; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob: asset: https://s4.anilist.co https://i.ytimg.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENjU0QkYxOUYwREM1RTIKUldUaXhRMmY4VXRsTFZWcXRra2l5cmtCN05DN01SUzRwTnFXM3hBT29qL3ZJNGc2d2l5anVCVVoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
